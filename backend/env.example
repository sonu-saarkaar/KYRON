# KYRON Backend Configuration
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=kyron_db

# JWT Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-please-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated if multiple)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# AI Provider Configuration
# Choose one: "nvidia", "openai" or "google"
AI_PROVIDER=nvidia

# NVIDIA NIM Configuration (Hermes-aligned)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini Configuration (if using Google)
GOOGLE_API_KEY=your-google-api-key-here

# Debug Mode
DEBUG=False

GROQ_API_KEY=your-groq-api-key-here