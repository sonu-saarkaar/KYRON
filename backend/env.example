# KYRON Backend Configuration
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=kyron_db

# JWT Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-please-use-a-strong-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated if multiple)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# AI Provider Configuration
# Choose one: "openai" or "google"
AI_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini Configuration (if using Google)
GOOGLE_API_KEY=your-google-api-key-here

# Debug Mode
DEBUG=False

